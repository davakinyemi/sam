#!/bin/sh
#
# Refuses a direct push to main. NFR-MAIN-01 requires that changes reach main
# through a pull request. Server-side enforcement is deferred (open item O6),
# so this hook is the local stand-in.
#
# It is NOT protection: it is bypassable with --no-verify, and it only exists in
# clones that have run `git config core.hooksPath .githooks`. When the repository
# becomes public, configure the ruleset in Task 2 Step 6a and this becomes belt
# and braces rather than the only guard.

protected_branch='refs/heads/main'

while read -r local_ref local_sha remote_ref remote_sha; do
	if [ "$remote_ref" = "$protected_branch" ]; then
		echo ""
		echo "  BLOCKED: direct push to main."
		echo ""
		echo "  main takes changes through a pull request from develop or a"
		echo "  feature branch (ADR-0006, NFR-MAIN-01). Try:"
		echo ""
		echo "      git switch develop"
		echo "      git push"
		echo "      gh pr create --base main"
		echo ""
		echo "  This is a local hook, not server-side protection. If you are"
		echo "  certain, --no-verify bypasses it. Needing that twice means the"
		echo "  workflow is wrong, not the hook."
		echo ""
		exit 1
	fi
done

exit 0